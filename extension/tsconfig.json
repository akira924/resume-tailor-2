{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["chrome", "vite/client", "node"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "src/*": ["../vite-ts/src/*"],
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "@react-pdf/renderer": ["./node_modules/@react-pdf/renderer"],
      "react-phone-number-input/input": ["./node_modules/react-phone-number-input/input/index.d.ts"],
      "dayjs": ["./node_modules/dayjs"],
      "dayjs/*": ["./node_modules/dayjs/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
